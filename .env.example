# PostgreSQL connection string used by Prisma and the app runtime.
DATABASE_URL="postgresql://muhasebe:muhasebe@localhost:5432/muhasebe?schema=public"

# Optional on Neon/Vercel: non-pooling URL for prisma migrate (advisory locks).
# If unset, build falls back to POSTGRES_URL_NON_POOLING or DATABASE_URL.
# DIRECT_URL=""

# Secret used to sign JWT session tokens. Use a long random string in production.
# Production: required, min 32 characters. Generate: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-secret-string-at-least-32-chars"

# Session lifetime in seconds (default 7 days).
SESSION_MAX_AGE="604800"

# Protects /api/cron/* endpoints. Required in production (Vercel Cron Authorization header).
# Generate: openssl rand -base64 32
CRON_SECRET=""

# Shared with okul-yonetim-sistemi (INTEGRATION_SECRET / SERVICE_API_SECRET). Used for finance webhooks + approve API.
# Generate: openssl rand -base64 48
INTEGRATION_SECRET=""

# Okul yönetim base URL (finance events are POSTed to {url}/api/webhook/muhasebe).
# Example: https://yonetim.leventokullari.com
OKUL_INTEGRATION_URL=""

# Read-only connection to the school operations Neon database (students + registration contracts).
SOURCE_DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Optional: which muhasebe tenant receives the import / integration. Defaults to the first school.
# SCHOOL_SYNC_TENANT_ID=""
