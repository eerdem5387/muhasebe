generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantRole {
  ADMIN
  ACCOUNTANT
  PRINCIPAL
  FOUNDER
}

enum PaymentChannel {
  EFT
  CREDIT_CARD
  CHECK
  CASH
}

enum RequestChannel {
  CREDIT_CARD
  TRANSFER
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum ScheduleStatus {
  BLOCKED
  EXPECTED
  REALIZED
}

enum EnrollmentStatus {
  ACTIVE
  CANCELLED
}

enum RegistrationStatus {
  NEW
  RENEWED
  NOT_RENEWED
}

enum PaymentProgress {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AttachmentKind {
  SLIP
  CHECK_PHOTO
  RECEIPT
  OTHER
}

enum ReportSide {
  INCOME
  EXPENSE
}

enum ReportPayKind {
  CASH
  CARD
}

model Tenant {
  id              String               @id @default(cuid())
  name            String
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  tenantUsers     TenantUser[]
  students        Student[]
  enrollments     Enrollment[]
  cardBanks       CardBankSetting[]
  scheduleLines   IncomeScheduleLine[]
  collections     Collection[]
  categories      LedgerCategory[]
  expenses        Expense[]
  expenseRequests ExpenseRequest[]
  attachments     Attachment[]
  schoolSyncRuns  SchoolSyncRun[]
  reportGroups    ReportGroup[]
  reportItems     ReportItem[]
  reportEntries   ReportEntry[]
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String
  isSuperAdmin Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  tenantUsers  TenantUser[]
}

model TenantUser {
  id        String     @id @default(cuid())
  tenantId  String
  userId    String
  role      TenantRole
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId])
}

model Student {
  id          String       @id @default(cuid())
  tenantId    String
  fullName    String
  classroom   String?
  parentPhone String?
  notes       String?
  registrationStatus RegistrationStatus @default(NOT_RENEWED)
  /// Source school-app student id. Null for students created in muhasebe.
  externalId  String?
  syncedAt    DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]

  @@unique([tenantId, externalId])
  @@index([tenantId])
}

model CardBankSetting {
  id          String       @id @default(cuid())
  tenantId    String
  bankName    String
  blockDays   Int          @default(30)
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]

  @@index([tenantId])
}

model Enrollment {
  id                 String               @id @default(cuid())
  tenantId           String
  studentId          String
  academicYear       String
  annualFee          Decimal              @db.Decimal(18, 2)
  announcedFee       Decimal?             @db.Decimal(18, 2)
  paymentChannel     PaymentChannel
  installmentCount   Int                  @default(1)
  cardBankId         String?
  enrolledAt         DateTime             @default(now())
  status             EnrollmentStatus     @default(ACTIVE)
  paymentProgress    PaymentProgress      @default(NOT_STARTED)
  paymentProgressManual Boolean           @default(false)
  notes              String?
  /// Source new_registrations / renewals id.
  externalId         String?
  sourceKind         String?
  sourcePaymentPlan  String?
  contractNo         String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  tenant             Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student            Student              @relation(fields: [studentId], references: [id], onDelete: Restrict)
  cardBank           CardBankSetting?     @relation(fields: [cardBankId], references: [id], onDelete: SetNull)
  scheduleLines      IncomeScheduleLine[]
  collections        Collection[]

  @@unique([tenantId, externalId])
  @@index([tenantId])
  @@index([studentId])
}

model IncomeScheduleLine {
  id               String         @id @default(cuid())
  tenantId         String
  enrollmentId     String
  installmentIndex Int
  amount           Decimal        @db.Decimal(18, 2)
  releaseDate      DateTime
  yearMonth        String
  status           ScheduleStatus @default(EXPECTED)
  plannedChannel   PaymentChannel?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enrollment       Enrollment     @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([tenantId, yearMonth])
  @@index([enrollmentId])
}

model Collection {
  id             String         @id @default(cuid())
  tenantId       String
  enrollmentId   String
  amount         Decimal        @db.Decimal(18, 2)
  collectedAt    DateTime
  paymentChannel PaymentChannel
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enrollment     Enrollment     @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  attachments    Attachment[]

  @@index([tenantId])
  @@index([enrollmentId])
}

model LedgerCategory {
  id        String       @id @default(cuid())
  tenantId  String
  type      CategoryType
  name      String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  expenses  Expense[]

  @@unique([tenantId, type, name])
  @@index([tenantId])
}

model ExpenseRequest {
  id                  String         @id @default(cuid())
  tenantId            String
  title               String
  quantity            Decimal        @db.Decimal(18, 4)
  unitPrice           Decimal        @db.Decimal(18, 2)
  total               Decimal        @db.Decimal(18, 2)
  requesterName       String
  channel             RequestChannel
  status              RequestStatus  @default(PENDING)
  notes               String?
  createdById         String
  principalApprovedAt DateTime?
  principalApprovedBy String?
  founderApprovedAt   DateTime?
  founderApprovedBy   String?
  rejectedAt          DateTime?
  rejectedById        String?
  rejectReason        String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  tenant              Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  expenses            Expense[]

  @@index([tenantId, status])
}

model Expense {
  id          String          @id @default(cuid())
  tenantId    String
  categoryId  String
  requestId   String?
  amount      Decimal         @db.Decimal(18, 2)
  spentAt     DateTime
  channel     RequestChannel?
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category    LedgerCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  request     ExpenseRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  attachments Attachment[]

  @@index([tenantId])
  @@index([categoryId])
}

model SchoolSyncRun {
  id                   String    @id @default(cuid())
  tenantId             String
  startedAt            DateTime  @default(now())
  finishedAt           DateTime?
  ok                   Boolean   @default(false)
  studentsUpserted     Int       @default(0)
  enrollmentsUpserted  Int       @default(0)
  error                String?
  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, startedAt])
}

model ReportGroup {
  id        String       @id @default(cuid())
  tenantId  String
  side      ReportSide
  name      String
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items     ReportItem[]

  @@unique([tenantId, side, name])
  @@index([tenantId, side])
}

model ReportItem {
  id        String         @id @default(cuid())
  tenantId  String
  groupId   String
  name      String
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  group     ReportGroup    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  entries   ReportEntry[]

  @@unique([groupId, name])
  @@index([tenantId])
}

model ReportEntry {
  id         String        @id @default(cuid())
  tenantId   String
  itemId     String
  yearMonth  String
  amount     Decimal       @db.Decimal(18, 2)
  occurredAt DateTime
  payKind    ReportPayKind @default(CASH)
  notes      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item       ReportItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([tenantId, yearMonth])
  @@index([itemId])
}

model Attachment {
  id           String         @id @default(cuid())
  tenantId     String
  collectionId String?
  expenseId    String?
  kind         AttachmentKind
  filename     String
  mimeType     String
  bytes        Bytes
  createdAt    DateTime       @default(now())
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  collection   Collection?    @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  expense      Expense?       @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([collectionId])
  @@index([expenseId])
}
